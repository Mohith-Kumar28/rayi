  "components": {
    "schemas": {
      "Problem": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference identifying the problem type."
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary. Safe to reword — do not branch on it."
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "HTTP status code."
          },
          "detail": {
            "description": "Human-readable explanation specific to this occurrence.",
            "type": "string"
          },
          "instance": {
            "description": "URI reference identifying this specific occurrence.",
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "unauthenticated",
              "forbidden",
              "step_up_required",
              "not_found",
              "idempotency_key_reused",
              "insufficient_unallocated_funds",
              "budget_envelope_exceeded",
              "daily_limit_exceeded",
              "deposit_not_settled",
              "organization_frozen",
              "conflict",
              "rate_limited",
              "internal_error"
            ],
            "description": "Stable machine-readable code. THIS is the contract."
          },
          "requestId": {
            "type": "string",
            "description": "Correlates to server logs. Always show this in support surfaces."
          },
          "challenge": {
            "type": "object",
            "properties": {
              "challengeId": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "challengeId",
              "reason",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "RFC 9457 problem details."
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-rayi.session",
        "description": "Host-only session cookie. The API is served same-origin with the app, so there is no CORS, no preflight and no SameSite=None."
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
