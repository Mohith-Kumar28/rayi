{
  "openapi": "3.1.0",
  "info": {
    "title": "Rayi API",
    "version": "0.1.0",
    "description": "Conditional payment rail for brand and creator collaborations. Money crosses this API as integer minor units in a string, never as a JSON number."
  },
  "paths": {
    "/v1/orgs/{orgId}/funds": {
      "get": {
        "operationId": "getOrgFunds",
        "summary": "Read an organization funding balance",
        "tags": [
          "funding"
        ],
        "description": "Returns available, clearing, pending and allocated balances plus the per-deposit lots behind them. Pending funds are shown but can never be allocated.",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The organization that owns the funds."
            },
            "description": "The organization that owns the funds."
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "orgId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "available": {
                      "type": "object",
                      "properties": {
                        "amountMinor": {
                          "type": "string",
                          "pattern": "^-?(0|[1-9][0-9]*)$",
                          "description": "Integer minor units as a string. Never a JSON number — precision is not optional here."
                        },
                        "currency": {
                          "type": "string",
                          "enum": [
                            "USD",
                            "CAD",
                            "EUR",
                            "GBP",
                            "AUD",
                            "INR",
                            "JPY",
                            "KRW",
                            "BHD",
                            "KWD"
                          ],
                          "description": "ISO-4217 currency code."
                        },
                        "exponent": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4,
                          "description": "Minor-unit exponent for this currency, supplied by the server. Never assume 2."
                        }
                      },
                      "required": [
                        "amountMinor",
                        "currency",
                        "exponent"
                      ],
                      "additionalProperties": false,
                      "description": "A monetary amount in integer minor units."
                    },
                    "clearing": {
                      "type": "object",
                      "properties": {
                        "amountMinor": {
                          "type": "string",
                          "pattern": "^-?(0|[1-9][0-9]*)$",
                          "description": "Integer minor units as a string. Never a JSON number — precision is not optional here."
                        },
                        "currency": {
                          "type": "string",
                          "enum": [
                            "USD",
                            "CAD",
                            "EUR",
                            "GBP",
                            "AUD",
                            "INR",
                            "JPY",
                            "KRW",
                            "BHD",
                            "KWD"
                          ],
                          "description": "ISO-4217 currency code."
                        },
                        "exponent": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4,
                          "description": "Minor-unit exponent for this currency, supplied by the server. Never assume 2."
                        }
                      },
                      "required": [
                        "amountMinor",
                        "currency",
                        "exponent"
                      ],
                      "additionalProperties": false,
                      "description": "A monetary amount in integer minor units."
                    },
                    "pending": {
                      "type": "object",
                      "properties": {
                        "amountMinor": {
                          "type": "string",
                          "pattern": "^-?(0|[1-9][0-9]*)$",
                          "description": "Integer minor units as a string. Never a JSON number — precision is not optional here."
                        },
                        "currency": {
                          "type": "string",
                          "enum": [
                            "USD",
                            "CAD",
                            "EUR",
                            "GBP",
                            "AUD",
                            "INR",
                            "JPY",
                            "KRW",
                            "BHD",
                            "KWD"
                          ],
                          "description": "ISO-4217 currency code."
                        },
                        "exponent": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4,
                          "description": "Minor-unit exponent for this currency, supplied by the server. Never assume 2."
                        }
                      },
                      "required": [
                        "amountMinor",
                        "currency",
                        "exponent"
                      ],
                      "additionalProperties": false,
                      "description": "A monetary amount in integer minor units."
                    },
                    "allocated": {
                      "type": "object",
                      "properties": {
                        "amountMinor": {
                          "type": "string",
                          "pattern": "^-?(0|[1-9][0-9]*)$",
                          "description": "Integer minor units as a string. Never a JSON number — precision is not optional here."
                        },
                        "currency": {
                          "type": "string",
                          "enum": [
                            "USD",
                            "CAD",
                            "EUR",
                            "GBP",
                            "AUD",
                            "INR",
                            "JPY",
                            "KRW",
                            "BHD",
                            "KWD"
                          ],
                          "description": "ISO-4217 currency code."
                        },
                        "exponent": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4,
                          "description": "Minor-unit exponent for this currency, supplied by the server. Never assume 2."
                        }
                      },
                      "required": [
                        "amountMinor",
                        "currency",
                        "exponent"
                      ],
                      "additionalProperties": false,
                      "description": "A monetary amount in integer minor units."
                    },
                    "lots": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "depositId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "available": {
                            "type": "object",
                            "properties": {
                              "amountMinor": {
                                "type": "string",
                                "pattern": "^-?(0|[1-9][0-9]*)$",
                                "description": "Integer minor units as a string. Never a JSON number — precision is not optional here."
                              },
                              "currency": {
                                "type": "string",
                                "enum": [
                                  "USD",
                                  "CAD",
                                  "EUR",
                                  "GBP",
                                  "AUD",
                                  "INR",
                                  "JPY",
                                  "KRW",
                                  "BHD",
                                  "KWD"
                                ],
                                "description": "ISO-4217 currency code."
                              },
                              "exponent": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4,
                                "description": "Minor-unit exponent for this currency, supplied by the server. Never assume 2."
                              }
                            },
                            "required": [
                              "amountMinor",
                              "currency",
                              "exponent"
                            ],
                            "additionalProperties": false,
                            "description": "A monetary amount in integer minor units."
                          },
                          "settledAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "Null while the ACH debit is still clearing."
                          },
                          "maturesAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "When this lot leaves its ACH return window and becomes releasable."
                          },
                          "fundedAt": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          }
                        },
                        "required": [
                          "depositId",
                          "available",
                          "settledAt",
                          "maturesAt",
                          "fundedAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "orgId",
                    "available",
                    "clearing",
                    "pending",
                    "allocated",
                    "lots"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-rayi-access": {
          "kind": "permission",
          "permission": "funds:read",
          "stepUp": false,
          "movesMoney": false
        }
      }
    },
