# Environment
TZ=UTC
NODE_ENV=local
IS_HTTPS=false
IS_WORKER=false

# Application
APP_NAME="Ultimate NestJS Boilerplate"
APP_URL=http://localhost:8000
APP_PORT=8000
APP_WORKER_PORT=8001
APP_DEBUG=false
APP_FALLBACK_LANGUAGE=en
APP_LOGGING=true
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://example.com
APP_LOCAL_FILE_UPLOAD=true

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_api
DATABASE_LOGGING=true
DATABASE_MAX_CONNECTIONS=250
DATABASE_SSL_MODE=disable
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=false
REDIS_CA=
REDIS_KEY=
REDIS_CERT=

# AWS
AWS_KEY=
AWS_SECRET=
AWS_S3_BUCKET=
AWS_REGION=EU_WEST_1

# Mail — Resend
#
# RESEND_API_KEY belongs ONLY on the worker. The api and webhooks processes are
# internet-reachable, and a compromise there able to send from our verified
# domain is a phishing capability against our own users — magic links are
# credentials. The api enqueues; the worker sends. Boot fails if this is set
# anywhere else.
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@rayi.test
MAIL_FROM_NAME=Rayi
MAIL_REPLY_TO=
# Staging only. Redirects EVERY outbound email here and records the real
# recipient in X-Rayi-Intended-Recipient. Sending a live magic link to a real
# brand's mailbox is not a mistake anyone gets to make twice.
MAIL_REDIRECT_ALL_TO=
# The Svix signing secret for Resend's webhooks. Held by whichever process
# serves /webhooks/resend. It VERIFIES — it cannot send — so unlike
# RESEND_API_KEY it is not worker-only. With it unset the endpoint refuses every
# delivery, because accepting unverified webhooks would let a stranger suppress
# any address they like, locking its owner out of sign-in.
RESEND_WEBHOOK_SECRET=

# Authentication
AUTH_SECRET=secret
# Basic Auth: This is required to access swagger docs, auth api docs, bull-board dashboard, etc. routes.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin-password
# GitHub OAuth: [Optional] Only include these if you want OAuth with GitHub. Otherwise, leave empty
GITHUB_CLIENT_ID="YOUR_GITHUB_APPLICATION_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_APPLICATION_CLIENT_SECRET"

# Rate Limiter
THROTTLER_ENABLED=false
THROTTLER_LIMIT=3
THROTTLER_TTL=1 # In seconds

# Queue
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false
QUEUE_FAILED_RETRY_ATTEMPTS=3

# Sentry
SENTRY_DSN=
SENTRY_LOGGING=false

# Grafana
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=grafana-password

# Docker
COMPOSE_PROFILES= # Available profiles = monitoring

# Stripe
#
# STRIPE_SECRET_KEY belongs ONLY on the worker — boot fails anywhere else. The
# api may hold a RESTRICTED key (rk_) scoped to Checkout Sessions and Account
# Links, which cannot create transfers.
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_KEY=
# TWO endpoints, TWO secrets. Connect events — account.updated, payout.paid,
# payout.failed, transfer.reversed — arrive on a separate endpoint with its own
# secret. Using the platform secret for both rejects every Connect delivery, and
# the symptom is a creator payout notification that simply never arrives.
STRIPE_WEBHOOK_SECRET_PLATFORM=
STRIPE_WEBHOOK_SECRET_CONNECT=
