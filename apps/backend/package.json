{
  "name": "@rayi/backend",
  "version": "0.0.0",
  "description": "Nest.js Boilerplate Prisma",
  "author": "duart3x",
  "private": true,
  "license": "MIT",
  "scripts": {
    "auth:surface": "tsx ./scripts/auth-surface.ts",
    "build": "nest build && pnpm run build:templates && pnpm run verify:build",
    "build:templates": "swc src -d dist --config-file .swcrc --extensions .tsx --strip-leading-paths --quiet",
    "db:test:down": "docker rm -f rayi-pg",
    "db:test:up": "docker run -d --rm --name rayi-pg -e POSTGRES_PASSWORD=rayi -e POSTGRES_USER=rayi -e POSTGRES_DB=rayi -p 55432:5432 postgres:17-alpine",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "docker:dev:down": "docker compose --env-file .env --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:up": "docker compose --env-file .env --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:prod:down": "docker compose --env-file .env --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:prod:up": "docker compose --env-file .env --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml up -d --build --force-recreate",
    "email:dev": "email dev --dir ./src/shared/mail/templates --port 3002",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate:deploy": "tsx ./scripts/migrate.ts",
    "prepare": "husky || true",
    "prisma:db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "start": "nest start",
    "start:debug": "concurrently -n api,email -c cyan,green \"nest start --debug --watch\" \"pnpm email:watch\"",
    "start:dev": "concurrently -n api,email -c cyan,green \"nest start --watch\" \"pnpm email:watch\"",
    "start:worker": "cross-env IS_WORKER=true nest start --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules pnpm exec jest",
    "test:contract": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-contract.json --runInBand",
    "test:cov": "pnpm run test --coverage",
    "test:debug": "cross-env NODE_OPTIONS='--inspect-brk --experimental-vm-modules' node -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm run test --config ./test/jest-e2e.json",
    "test:it": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-integration.json --runInBand",
    "test:watch": "pnpm run test --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:auth-surface": "tsx ./scripts/auth-surface.ts --check",
    "verify:build": "tsx ./scripts/verify-build.ts",
    "verify:stripe": "tsx scripts/verify-stripe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@bull-board/api": "^6.11.0",
    "@bull-board/fastify": "^6.11.0",
    "@bull-board/nestjs": "^6.11.0",
    "@fastify/cookie": "11.0.2",
