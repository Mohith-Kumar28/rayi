# Database
DOCKER_DATABASE_PORT=15432

# Redis
DOCKER_REDIS_PORT=16379

# Mail — Resend
#
# RESEND_API_KEY belongs ONLY on the worker. The api and webhooks processes are
# internet-reachable, and a compromise there able to send from our verified
# domain is a phishing capability against our own users — magic links are
# credentials. The api enqueues; the worker sends. Boot fails if this is set
# anywhere else.
RESEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@rayi.test
MAIL_FROM_NAME=Rayi
MAIL_REPLY_TO=
# Staging only. Redirects EVERY outbound email here and records the real
# recipient in X-Rayi-Intended-Recipient. Sending a live magic link to a real
# brand's mailbox is not a mistake anyone gets to make twice.
MAIL_REDIRECT_ALL_TO=

# Prometheus
DOCKER_PROMETHEUS_PORT=19090

# Grafana
DOCKER_GRAFANA_PORT=19091

# Postgres Monitoring
DOCKER_PG_EXPORTER=19187